rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Aplikasi tidak menyediakan pendaftaran. Buat akun pengguna secara manual
    // melalui Firebase Console, lalu akses data dibatasi ke pengguna terautentikasi.
    match /input_1/{document} {
      allow read, write: if signedIn();
    }
    match /input_2/{document} {
      allow read, write: if signedIn();
    }
  }
}